<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/item_background"
    android:layout_marginBottom="10dp" android:padding="16dp">
    <TextView android:id="@+id/txtRecipeName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold"
        android:textColor="#1B5E20"/>
    <TextView android:id="@+id/txtRecipeHint" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="All required ingredients available"
        android:textColor="#555555" android:layout_marginTop="5dp"/>
</LinearLayout>
