<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/item_background"
    android:layout_marginBottom="10dp" android:padding="14dp">
    <TextView android:id="@+id/txtName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold"/>
    <TextView android:id="@+id/txtQuantity" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#555555"
        android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/txtExpiry" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#777777"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="end" android:layout_marginTop="6dp">
        <Button android:id="@+id/btnEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit"/>
        <Button android:id="@+id/btnDelete" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Delete"/>
    </LinearLayout>
</LinearLayout>
