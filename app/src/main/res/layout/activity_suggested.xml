<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F7F5">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Suggested Recipes" android:textSize="25sp" android:textStyle="bold"
        android:textColor="#1B5E20" android:padding="16dp"/>
    <TextView android:id="@+id/txtMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Recipes you can make right now:" android:textSize="15sp"
        android:textColor="#555555" android:paddingLeft="16dp" android:paddingRight="16dp"
        android:paddingBottom="8dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRecipes" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:padding="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp" android:background="#FFFFFF">
        <Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Home"/>
        <Button android:id="@+id/navPantry" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Pantry"/>
    </LinearLayout>
</LinearLayout>
